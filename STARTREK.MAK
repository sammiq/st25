# STARTREK.MAK - rebuild STARTREK.EXE with Microsoft C 6.00A, MASM 5.0 and
# LINK 5.10, the way the original was built.
#
#   NMAKE /F STARTREK.MAK
#
# Run under DOS (or emu2, see tools/dosbuild.py) with the project root as D:,
# tools\C600 as C: and tools\MASM50 as E:. Objects and the EXE go to
# BUILD\DOS.

O       = BUILD\DOS
CC      = C:\BIN\CL
AS      = E:\BIN\MASM
LINK    = C:\BINB\LINK

CFLAGS  = /c /nologo /AM /G2 /qc /Gs /Zp1 /W3 /ID:\INCLUDE
AFLAGS  = /Ml /t

# BSS.OBJ (generated by tools/genbss.py) pins the uninitialized globals to
# their original addresses; it must be the last object.
# Link order: the game modules, each in its own code segment, with the
# assembly module that opens _TEXT after seg025. The C runtime fills the rest
# of _TEXT, and the emulator's segments follow the game's.
OBJS1   = $O\SEG000.OBJ $O\SEG001.OBJ $O\SEG002.OBJ $O\SEG003.OBJ $O\SEG004.OBJ \
          $O\SEG005.OBJ $O\SEG006.OBJ $O\SEG007.OBJ $O\SEG008.OBJ $O\SEG009.OBJ \
          $O\SEG010.OBJ $O\SEG011.OBJ $O\SEG012.OBJ $O\SEG013.OBJ $O\SEG014.OBJ \
          $O\SEG015.OBJ $O\SEG016.OBJ $O\SEG017.OBJ $O\SEG018.OBJ $O\SEG019.OBJ
OBJS2   = $O\SEG020.OBJ $O\SEG021.OBJ $O\SEG022.OBJ $O\SEG023.OBJ $O\SEG024.OBJ \
          $O\SEG025.OBJ $O\T35052.OBJ $O\SEG027.OBJ $O\SEG028.OBJ $O\SEG029.OBJ \
          $O\SEG030.OBJ $O\SEG031.OBJ $O\SEG032.OBJ $O\SEG033.OBJ $O\SEG034.OBJ \
          $O\SEG035.OBJ $O\SEG036.OBJ $O\BSS.OBJ
# The combined medium-model, emulator-math library that C 6.00 SETUP builds
# from its parts. LINK lays out one library's modules in library order, which
# is how the original's runtime is ordered.
LIBS    = $O\MLIBCE.LIB
LIBEXE  = C:\BINB\LIB

$O\STARTREK.EXE: $(OBJS1) $(OBJS2) $(LIBS)
        $(LINK) /NOLOGO /NOI /NOD /NONULLSDOSSEG /EXEPACK /MAP /ST:0xF00 @<<
$O\SEG000.OBJ+
$O\SEG001.OBJ+
$O\SEG002.OBJ+
$O\SEG003.OBJ+
$O\SEG004.OBJ+
$O\SEG005.OBJ+
$O\SEG006.OBJ+
$O\SEG007.OBJ+
$O\SEG008.OBJ+
$O\SEG009.OBJ+
$O\SEG010.OBJ+
$O\SEG011.OBJ+
$O\SEG012.OBJ+
$O\SEG013.OBJ+
$O\SEG014.OBJ+
$O\SEG015.OBJ+
$O\SEG016.OBJ+
$O\SEG017.OBJ+
$O\SEG018.OBJ+
$O\SEG019.OBJ+
$O\SEG020.OBJ+
$O\SEG021.OBJ+
$O\SEG022.OBJ+
$O\SEG023.OBJ+
$O\SEG024.OBJ+
$O\SEG025.OBJ+
$O\T35052.OBJ+
$O\SEG027.OBJ+
$O\SEG028.OBJ+
$O\SEG029.OBJ+
$O\SEG030.OBJ+
$O\SEG031.OBJ+
$O\SEG032.OBJ+
$O\SEG033.OBJ+
$O\SEG034.OBJ+
$O\SEG035.OBJ+
$O\SEG036.OBJ+
$O\BSS.OBJ
$O\STARTREK.EXE
$O\STARTREK.MAP
$(LIBS);
<<

$O\MLIBCE.LIB: C:\LIB\MLIBCR.LIB C:\LIB\LIBH.LIB C:\LIB\MLIBFP.LIB C:\LIB\EM.LIB
        $(LIBEXE) /NOLOGO $@ +C:\LIB\MLIBCR.LIB+C:\LIB\LIBH.LIB+C:\LIB\MLIBFP.LIB+C:\LIB\EM.LIB;

{SRC}.c{$O}.obj:
        $(CC) $(CFLAGS) /Fo$@ $<

{SRC}.asm{$O}.obj:
        $(AS) $(AFLAGS) $<,$@;

{SRC\ASM}.asm{$O}.obj:
        $(AS) $(AFLAGS) $<,$@;

# seg006 was compiled with CodeView information: QC then keeps an fwait
# after every floating point store at the end of a line, and the object's
# reference to __aDBused links in the runtime's debugger hooks (dbscrswp).
$O\SEG006.OBJ: SRC\SEG006.C
        $(CC) $(CFLAGS) /Zi /Fo$@ SRC\SEG006.C
